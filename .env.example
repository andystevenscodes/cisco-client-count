# Copy to .env and fill in. Generate a secret with:  openssl rand -hex 24

# ── required ────────────────────────────────────────────────────────────────
# Password for the web interface.
ADMIN_PASSWORD=
# Password of the database owner (only used between the two containers).
POSTGRES_PASSWORD=
# Signs the login cookie. Keep it stable, or everyone is signed out on restart.
SECRET_KEY=

# ── Power BI ────────────────────────────────────────────────────────────────
# Password for the web export (/export/...). User name is free, e.g. "powerbi".
# Empty: the export only works while signed in to the web interface.
EXPORT_TOKEN=
# Password of the read-only database user "powerbi". Empty: no such user.
POWERBI_DB_PASSWORD=
# 0.0.0.0 publishes PostgreSQL on the network for Power BI's database connector.
DB_BIND=127.0.0.1
DB_PORT=5432

# ── network ─────────────────────────────────────────────────────────────────
# Port the controller sends telemetry to.
TELEMETRY_PORT=57500
# Web interface.
WEB_BIND=0.0.0.0
WEB_PORT=8080
# Only accept telemetry from these addresses or networks (comma separated).
# Empty accepts any source that can reach the port.
ALLOWED_WLC_SOURCES=
# Set to true when the web interface is only reached over https (reverse proxy).
SESSION_COOKIE_SECURE=false

# ── counting ────────────────────────────────────────────────────────────────
TZ=Europe/Amsterdam
# Client states that count as connected.
COUNT_STATES=client-status-run
# A periodic update is complete when the stream has been quiet this long.
CYCLE_GAP_SECONDS=5
# true: client MAC addresses become a pseudonym and user names are hidden
# before a message is kept. The count itself is not affected.
ANONYMIZE_CLIENTS=false
# Days the per-count rows are kept. The hourly table is kept indefinitely.
RETENTION_DAYS=400
# Messages kept in memory for the Raw data page.
RAW_BUFFER_MESSAGES=500
